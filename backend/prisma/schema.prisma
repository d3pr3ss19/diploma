generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  ADMIN
  OPERATOR
  SUBSCRIBER
}

enum MeterType {
  COLD_WATER
  HOT_WATER
  ELECTRICITY
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

enum RequestCategory {
  ACCIDENT
  COMPLAINT
  QUESTION
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  DONE
  REJECTED
}

model Role {
  id    Int      @id @default(autoincrement())
  code  RoleCode @unique
  name  String
  users User[]
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String       @map("password_hash")
  roleId       Int          @map("role_id")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  role         Role         @relation(fields: [roleId], references: [id])
  subscriber   Subscriber?
  readings     MeterReading[] @relation("ReadingSubmittedBy")

  createdRequests  Request[]              @relation("RequestCreatedBy")
  assignedRequests Request[]              @relation("RequestAssignedTo")
  statusChanges    RequestStatusHistory[] @relation("RequestStatusChangedBy")

  @@map("users")
}


model RefreshSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_sessions")
}

model Subscriber {
  id        String   @id @default(uuid())
  userId    String?  @unique @map("user_id")
  fullName  String   @map("full_name")
  phone     String
  address   String
  apartment String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User?     @relation(fields: [userId], references: [id])
  accounts Account[]

  @@map("subscribers")
}

model Account {
  id            String    @id @default(uuid())
  subscriberId  String    @map("subscriber_id")
  accountNumber String    @unique @map("account_number")
  balance       Decimal   @db.Decimal(12, 2)
  isActive      Boolean   @default(true) @map("is_active")
  openedAt      DateTime  @db.Date @map("opened_at")

  subscriber Subscriber @relation(fields: [subscriberId], references: [id])
  meters     Meter[]
  accruals   Accrual[]
  payments   Payment[]
  requests   Request[]

  @@map("accounts")
}

model Meter {
  id           String    @id @default(uuid())
  accountId    String    @map("account_id")
  meterType    MeterType @map("meter_type")
  serialNumber String    @unique @map("serial_number")
  installedAt  DateTime  @db.Date @map("installed_at")
  isActive     Boolean   @default(true) @map("is_active")

  account  Account        @relation(fields: [accountId], references: [id])
  readings MeterReading[]

  @@map("meters")
}

model MeterReading {
  id                String   @id @default(uuid())
  meterId           String   @map("meter_id")
  readingPeriod     DateTime @db.Date @map("reading_period")
  value             Decimal  @db.Decimal(12, 3)
  submittedByUserId String   @map("submitted_by_user_id")
  submittedAt       DateTime @default(now()) @map("submitted_at")

  meter           Meter @relation(fields: [meterId], references: [id])
  submittedByUser User  @relation("ReadingSubmittedBy", fields: [submittedByUserId], references: [id])

  @@unique([meterId, readingPeriod])
  @@map("meter_readings")
}

model Tariff {
  id           String    @id @default(uuid())
  serviceType  String    @map("service_type")
  pricePerUnit Decimal   @db.Decimal(12, 4) @map("price_per_unit")
  effectiveFrom DateTime @db.Date @map("effective_from")
  effectiveTo   DateTime? @db.Date @map("effective_to")
  isActive      Boolean   @default(true) @map("is_active")

  @@map("tariffs")
}

model Accrual {
  id          String   @id @default(uuid())
  accountId   String   @map("account_id")
  period      DateTime @db.Date
  serviceType String   @map("service_type")
  consumption Decimal  @db.Decimal(12, 3)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id])

  @@map("accruals")
}

model Payment {
  id          String        @id @default(uuid())
  accountId   String        @map("account_id")
  paymentDate DateTime      @db.Date @map("payment_date")
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  externalRef String?       @map("external_ref")
  createdAt   DateTime      @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id])

  @@map("payments")
}

model Request {
  id               String          @id @default(uuid())
  accountId        String          @map("account_id")
  title            String
  description      String
  category         RequestCategory
  status           RequestStatus
  createdByUserId  String          @map("created_by_user_id")
  assignedToUserId String?         @map("assigned_to_user_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  account        Account                @relation(fields: [accountId], references: [id])
  createdByUser  User                   @relation("RequestCreatedBy", fields: [createdByUserId], references: [id])
  assignedToUser User?                  @relation("RequestAssignedTo", fields: [assignedToUserId], references: [id])
  history        RequestStatusHistory[]

  @@map("requests")
}

model RequestStatusHistory {
  id              String        @id @default(uuid())
  requestId       String        @map("request_id")
  oldStatus       RequestStatus @map("old_status")
  newStatus       RequestStatus @map("new_status")
  changedByUserId String        @map("changed_by_user_id")
  changedAt       DateTime      @default(now()) @map("changed_at")
  comment         String?

  request       Request @relation(fields: [requestId], references: [id])
  changedByUser User    @relation("RequestStatusChangedBy", fields: [changedByUserId], references: [id])

  @@map("request_status_history")
}
